NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

DATABASE_URL=postgresql+asyncpg://tripops:tripops@postgres:5432/tripops
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=tripops
MINIO_SECRET_KEY=tripops-secret

# LLM（火山引擎 Ark，OpenAI-compatible）
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
LLM_API_KEY=
LLM_MODEL=ark-code-latest

# Embedding（Ollama）
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=qwen3-embedding:0.6b

# 文生图（ComfyUI）—— 设为 true 使用预处理素材
MOCK_IMAGEGEN=true
IMAGEGEN_API_URL=http://127.0.0.1:8188

MOCK_MODEL_MODE=false

# Tavily Remote MCP：从 https://app.tavily.com 获取 API Key
TAVILY_SEARCH_ENABLED=true
TAVILY_MCP_URL=https://mcp.tavily.com/mcp
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
TAVILY_SEARCH_TIMEOUT_SECONDS=30
TAVILY_FALLBACK_TO_DEMO=true
